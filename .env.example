# Change this to the NAS address and port used to access Trippino.
API_BASE=http://localhost:5000
TRIPPINO_PORT=5000

# Synology example: /volume1/docker/trippino/data
TRIPPINO_DATA_DIR=./data

# Optional app settings
TOMTOM_API_KEY=
SKIP_EMAIL_SENDING=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
